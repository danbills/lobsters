# See README.md for instructions.

# Used as the base secret for all MessageVerifiers in Rails, including the one protecting cookies.
secret_key_base: "secret"

diffbot:
  api_key: null

github:
  client_id: null
  client_secret: null

mastodon:
# mastodon bot posting setup (not needed for account linking)
# 1. visit instance to register your desired username
# 2. run `rails credentials:edit` to enter instance name and username
  instance_name: "mastodon.social"
  bot_name: "lobsters"
# 3. run Mastodon.get_bot_credentials! in the prod rails console for these three values
  client_id: null
  client_secret: null
  token: null
# 4. create a list in the web ui, see the ID in the URL when you edit
  list_id: null

pushover:
  api_token: null
  subscription_code: null

# OpenID Connect login. Each provider gets POST /auth/<name> to start login and
# <base_url>/auth/<name>/callback as the redirect URI to register at the provider.
# Adding or swapping a provider is a config change only, see app/models/oidc_provider.rb.
oidc:
  base_url: "http://localhost:3000" # where this site is reached; defaults to Rails.application.root_url
  providers:
    keycloak:
      label: "Keycloak"
      issuer: "https://keycloak.example.org/realms/example"
      client_id: "lobsters"
      client_secret: "..."
      username_claim: "preferred_username" # suggested username at signup, user can change it
      trust_email_verified: true # link existing users by verified email on first login
      groups_claim: "groups"
      required_group: null # if set, only members of this group may log in
    # okta:
    #   label: "Okta"
    #   issuer: "https://<org>.okta.com/oauth2/default"
    #   client_id: "..."
    #   client_secret: "..."
    #   username_claim: "preferred_username" # Okta sends the login email, its local part is used
    #   trust_email_verified: true
    #   groups_claim: "groups" # add a groups claim on the Okta authorization server to use this
    #   required_group: null
